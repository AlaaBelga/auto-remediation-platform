FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY predictive_engine/requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

COPY predictive_engine/api.py .
COPY predictive_engine/model.joblib .
COPY predictive_engine/rul_model.joblib .
COPY predictive_engine/anomaly_model.joblib .
COPY predictive_engine/model_features.joblib .
COPY predictive_engine/feature_profile.joblib .

RUN useradd --create-home appuser \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health').read()" || exit 1

CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000"]
